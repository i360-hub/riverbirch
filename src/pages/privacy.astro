---
// Privacy Policy — ported verbatim from the live /privacy page.
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/layout/PageHeader.astro";
import Icon from "@components/ui/Icon.astro";
import { site } from "@data/site";

const sections = [
  {
    h: "Information Collection and Use",
    p: [
      "We collect information directly from you, such as your name, phone number, email address, and project details, when you contact us for our services. We use this information to:",
    ],
    list: [
      "Respond to your inquiries",
      "Provide the services you have requested",
      "Send updates and information about our services",
      "Improve our services and customer experience",
    ],
  },
  {
    // A2P 10DLC: opt-in is the SMS consent chat widget ONLY — never a form, never
    // "you gave us your number". The final paragraph is the carrier-mandated
    // mobile-information non-sharing clause: reviewers pattern-match its exact
    // wording, so it is reproduced verbatim. Do not paraphrase or condense it.
    h: "Text Messaging (SMS/MMS)",
    p: [
      "River Birch Tree Service LLC sends text messages only to people who have opted in through the SMS consent chat widget on this website. Submitting a form on this site, or providing your phone number by any other means, does not enroll you in text messages.",
      "Messages are limited to customer care: estimate follow-ups, appointment confirmations, scheduling changes, crew arrival notifications, and job status updates. We do not send marketing or promotional text messages.",
      "Message frequency varies based on your interactions with us. Message and data rates may apply. Reply STOP at any time to opt out, or HELP for help. Carriers are not liable for delayed or undelivered messages.",
      "No mobile information will be shared with third parties or affiliates for marketing or promotional purposes. Information sharing to subcontractors in support services, such as customer service, is permitted. All other use case categories exclude text messaging originator opt-in data and consent; this information will not be shared with any third parties.",
    ],
  },
  {
    h: "Sharing of Information",
    p: [
      "We do not sell or rent your personal information to third parties. We may share your information with service providers who perform services on our behalf, such as sending emails or texts, under strict confidentiality agreements. We may also disclose information if required by law or to protect our rights and safety or the rights and safety of others.",
    ],
  },
  {
    h: "Data Security",
    p: [
      "We take reasonable measures to protect the information you provide to us from loss, theft, misuse, unauthorized access, disclosure, alteration, and destruction.",
    ],
  },
  {
    h: "Changes to This Privacy Policy",
    p: [
      "We may update this Privacy Policy from time to time. We will notify you of any changes by posting the new Privacy Policy on this page. You are advised to review this Privacy Policy periodically for any changes.",
    ],
  },
  {
    h: "Consent",
    p: [
      "By using our services and providing us with your information, you consent to our collection, use, and sharing of your information as described in this Privacy Policy.",
    ],
  },
];
---

<BaseLayout
  title="Privacy Policy | River Birch Tree Service | Deep Gap NC"
  description="How River Birch Tree Service collects, uses, and protects your information. Serving Deep Gap, NC and the High Country."
  path="/privacy"
>
  <PageHeader
    eyebrow="Legal"
    title="Privacy Policy"
    subtitle="River Birch Tree Service is committed to protecting the privacy and security of our customers' information. Effective August 15, 2026."
  />

  <section class="cpr-section privacy">
    <div class="privacy__inner">
      <p class="privacy__intro">
        River Birch Tree Service, located in Deep Gap, NC, is committed to protecting the privacy and
        security of our customers' information. This Privacy Policy outlines our practices concerning the
        collection, use, and sharing of your information through our communications and services.
      </p>

      <div class="privacy__contact">
        <h2>Contact Information</h2>
        <p>For any privacy-related questions, please contact us at:</p>
        <ul role="list">
          {/* Legal page: cites the REAL business number (napPhone), which is the
              number the SMS program is registered to — not the call-tracking line. */}
          <li><Icon name="phone" /> <a href={site.napPhoneHref}>{site.napPhoneDisplay}</a></li>
          <li><Icon name="mail" /> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><Icon name="pin" /> {site.address.city}, {site.address.state} · {site.address.region}</li>
        </ul>
      </div>

      {
        sections.map((s) => (
          <div class="privacy__section">
            <h2>{s.h}</h2>
            {s.p.map((para) => <p>{para}</p>)}
            {s.list && (
              <ul class="privacy__list" role="list">
                {s.list.map((item) => (<li><Icon name="check" /> <span>{item}</span></li>))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .privacy__inner {
    max-width: var(--cpr-max-width-narrow);
    margin-inline: auto;
  }
  .privacy__intro {
    font-size: 1.1rem;
    color: var(--cpr-slate);
    line-height: 1.7;
    margin-bottom: var(--cpr-space-xl);
  }
  .privacy__contact {
    background: var(--cpr-bg-light);
    border-radius: var(--cpr-radius-lg);
    padding: var(--cpr-space-xl);
    margin-bottom: var(--cpr-space-2xl);
  }
  .privacy__contact h2 {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
  }
  .privacy__contact ul {
    display: grid;
    gap: 0.6rem;
    margin-top: var(--cpr-space-md);
  }
  .privacy__contact li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--cpr-slate);
    font-weight: 600;
  }
  .privacy__contact :global(svg) {
    color: var(--cpr-red);
    flex: none;
  }
  .privacy__contact a {
    color: var(--cpr-red-dark);
    text-decoration: underline;
  }
  .privacy__section {
    margin-bottom: var(--cpr-space-xl);
  }
  .privacy__section h2 {
    font-size: 1.35rem;
    margin-bottom: 0.6rem;
  }
  .privacy__section p {
    color: var(--cpr-slate);
    line-height: 1.75;
    margin-bottom: var(--cpr-space-sm);
  }
  .privacy__list {
    display: grid;
    gap: 0.5rem;
    margin-top: var(--cpr-space-sm);
  }
  .privacy__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    color: var(--cpr-slate);
    line-height: 1.6;
  }
  .privacy__list :global(svg) {
    color: #16a34a;
    margin-top: 0.25rem;
    flex: none;
  }
</style>
