---
import LandingLayout from "@layouts/LandingLayout.astro";
import ResponsivePicture from "@components/ui/ResponsivePicture.astro";
import ContactForm from "@components/widgets/ContactForm.astro";
import Icon from "@components/ui/Icon.astro";
import { landing } from "@data/landing";
import { reviews } from "@data/reviews";
import heroImg from "@assets/images/deep-gap-nc-arborist-chainsaw-tree-removal-hero.webp";

const pageTitle = "Tree Service in Boone, NC | Free Estimates — River Birch";
const pageDescription =
  "Tree removal, trimming, and fast storm & ice cleanup in Boone, NC. Fully insured, owner-operated, free on-site written estimates. Call (828) 818-8505.";

const reviewNames = ["Jimmie Fugate", "Travis Pierce", "William Ballinger"];
const lpReviews = reviewNames
  .map((name) => reviews.find((r) => r.name === name))
  .filter((r): r is (typeof reviews)[number] => Boolean(r));

const trustItems = [
  { icon: "shield", label: "Fully Insured" },
  { icon: "check", label: "Free On-Site Estimates" },
  { icon: "tree", label: "Owner-Operated — Ezequiel Moreno" },
  { icon: "leaf", label: "Complete Cleanup & Haul-Away" },
  { icon: "clock", label: "Mon–Sat 7 AM–7 PM" },
];

const services = [
  {
    icon: "tree",
    title: "Tree Removal",
    body:
      "Safe takedowns on tight lots near App State and downtown — rope-and-lower sectioning keeps falling wood clear of homes, cars, and fences.",
  },
  {
    icon: "leaf",
    title: "Tree Trimming & Pruning",
    body:
      "Clearance pruning, deadwood removal, and thinning for the silver maples and oaks that crowd Boone yards and ridgetop homes.",
  },
  {
    icon: "storm",
    title: "Storm & Ice Cleanup",
    body:
      "Fast storm cleanup with priority scheduling for storm & ice emergencies — downed limbs, split trunks, and blocked drives cleared quickly.",
  },
  {
    icon: "mountain",
    title: "Land & Lot Clearing",
    body:
      "Brush, undergrowth, and selective clearing for mountain lots and building sites across the High Country.",
  },
];

const steps = [
  {
    icon: "phone",
    title: "Call or send the form",
    body: "Tell us what you need. We answer fast during business hours.",
  },
  {
    icon: "check",
    title: "Free on-site written estimate",
    body: "We walk the property, talk through the work, and leave it in writing.",
  },
  {
    icon: "tree",
    title: "We do the work & haul it away",
    body: "Clean, careful removal with complete cleanup and haul-away when we're done.",
  },
];

const faqs = [
  {
    q: "Can you remove a tree on a tight lot near App State or downtown?",
    a:
      "Yes. Close-quarters lots are our specialty. We use rope-and-lower techniques to bring trees down in controlled sections, protecting neighboring homes, cars, fences, and landscaping on narrow in-town properties.",
  },
  {
    q: "Do you work on rentals and student housing?",
    a:
      "We do. We handle work for rental owners and property managers throughout Boone, and we're happy to coordinate scheduling and provide a written estimate before any work begins.",
  },
  {
    q: "How fast can you respond after a storm or ice event?",
    a:
      "We offer priority scheduling for storm & ice emergencies and fast storm cleanup — reach out as soon as it's safe and we'll get you on the schedule as fast as we can during our Mon–Sat 7 AM–7 PM hours.",
  },
  {
    q: "Are your estimates really free?",
    a:
      "Yes. Every estimate is free, written, and no-pressure. We come out, look at the job in person, and give you the price in writing — no obligation to book.",
  },
];
---

<LandingLayout
  title={pageTitle}
  description={pageDescription}
  path="/lp/boone-tree-service"
  town="Boone"
>
  <script is:inline>
    try {
      sessionStorage.setItem("rb_lp", "boone");
    } catch (e) {}
  </script>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-media">
      <ResponsivePicture
        src={heroImg}
        alt="River Birch tree climber working against a blue sky in Boone, NC"
        objectPosition="50% 42%"
        priority
      />
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-inner">
      <div class="hero-copy">
        <h1>Tree Service in Boone, NC</h1>
        <p class="hero-sub">
          Tree removal, trimming &amp; pruning, and fast storm &amp; ice cleanup
          in Boone and the surrounding High Country. Fully insured,
          owner-operated, and backed by free on-site estimates.
        </p>
        <div class="hero-cta">
          <a class="btn btn-call" href={landing.phoneHref}>
            <Icon name="phone" />
            Call {landing.phoneDisplay}
          </a>
          <a class="btn btn-estimate" href="#estimate">Get My Free Estimate</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="trust" aria-label="Why choose River Birch">
    <ul class="trust-list">
      {trustItems.map((item) => (
        <li><Icon name={item.icon} /> {item.label}</li>
      ))}
    </ul>
  </section>

  <!-- Services -->
  <section class="services">
    <div class="wrap">
      <h2>Tree Services in Boone</h2>
      <div class="services-grid">
        {services.map((s) => (
          <article class="service-card">
            <span class="service-icon"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
      <p class="services-note">
        Need the trunk gone too? We also handle stump grinding to finish the job.
      </p>
    </div>
  </section>

  <!-- Local -->
  <section class="local">
    <div class="wrap local-inner">
      <div class="local-copy">
        <h2>Tree Work in Boone</h2>
        <p>
          Boone keeps us busy in two very different settings. In-town lots near
          App State and downtown are tight, with homes, parked cars, and fences
          close on every side. Up on the ridgetops, access is steep and the wind
          and ice take a toll on big trees. Either way, we plan the job to bring
          the tree down safely.
        </p>
        <p>
          That's where rope-and-lower removals earn their keep — we take trees
          apart in controlled sections instead of dropping them, so nothing lands
          where it shouldn't. The silver maples and oaks that shade a lot of Boone
          properties are prone to splitting and deadwood, and ice storms off the
          mountain can bring limbs down fast. We clear it, clean it up, and haul
          everything away.
        </p>
      </div>
    </div>
  </section>

  <!-- Mid-page CTA band -->
  <section class="cta-band">
    <div class="wrap cta-band-inner">
      <div>
        <h2>Ready for a free estimate?</h2>
        <p>Talk to us directly — Mon–Sat 7 AM–7 PM.</p>
      </div>
      <a class="btn btn-call btn-lg" href={landing.phoneHref}>
        <Icon name="phone" />
        Call {landing.phoneDisplay}
      </a>
    </div>
  </section>

  <!-- Reviews -->
  <section class="reviews">
    <div class="wrap">
      <h2>What Boone Neighbors Say</h2>
      <div class="reviews-grid">
        {lpReviews.map((r) => (
          <article class="review-card">
            <div class="stars" aria-label="5 out of 5 stars">
              {[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}
            </div>
            <p class="review-text">{r.text}</p>
            <p class="review-name">— {r.name}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="how">
    <div class="wrap">
      <h2>How It Works</h2>
      <ol class="how-grid">
        {steps.map((step, i) => (
          <li class="how-step">
            <span class="how-num">{i + 1}</span>
            <span class="how-icon"><Icon name={step.icon} /></span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="wrap">
      <h2>Boone Tree Service FAQs</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="form-section">
    <div class="wrap">
      <ContactForm
        id="estimate"
        heading="Request Your Free Estimate"
        formSrc={landing.formSrc}
        formId={landing.formId}
        formName={landing.formName}
      />
    </div>
  </section>
</LandingLayout>

<style>
  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  h2 {
    color: var(--cpr-navy);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 0 0 1.5rem;
  }

  /* Services */
  .services {
    padding: 3.5rem 0;
    background: #fff;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.25rem;
  }
  .service-card {
    border: 1px solid #e3e8e3;
    border-radius: 10px;
    padding: 1.5rem;
    background: #fbfdfb;
  }
  .service-icon {
    display: inline-flex;
    color: var(--cpr-red);
    margin-bottom: 0.5rem;
  }
  .service-card h3 {
    color: var(--cpr-navy);
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
  }
  .service-card p {
    margin: 0;
    line-height: 1.5;
    color: #33433a;
  }
  .services-note {
    margin: 1.5rem 0 0;
    text-align: center;
    color: #475a4e;
    font-style: italic;
  }

  /* Local */
  .local {
    padding: 3.5rem 0;
    background: #f3f6f3;
  }
  .local-copy {
    max-width: 760px;
  }
  .local-copy p {
    line-height: 1.65;
    color: #28342c;
    margin: 0 0 1rem;
  }

  /* CTA band */
  
  .cta-band-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .cta-band h2 {
    color: #fff;
    margin: 0 0 0.25rem;
  }
  .cta-band p {
    margin: 0;
  }
  

  /* Reviews */
  .reviews {
    padding: 3.5rem 0;
    background: #fff;
  }
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .review-card {
    border: 1px solid #e3e8e3;
    border-radius: 10px;
    padding: 1.5rem;
    background: #fbfdfb;
  }
  .stars {
    display: inline-flex;
    gap: 2px;
    color: #f5a623;
    margin-bottom: 0.75rem;
  }
  .review-text {
    line-height: 1.55;
    color: #28342c;
    margin: 0 0 0.75rem;
  }
  .review-name {
    margin: 0;
    font-weight: 700;
    color: var(--cpr-navy);
  }

  /* How it works */
  .how {
    padding: 3.5rem 0;
    background: #f3f6f3;
  }
  .how-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .how-step {
    background: #fff;
    border: 1px solid #e3e8e3;
    border-radius: 10px;
    padding: 1.75rem 1.5rem;
    text-align: center;
    position: relative;
  }
  .how-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--cpr-navy);
    color: #fff;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .how-icon {
    display: block;
    color: var(--cpr-red);
    margin: 0 auto 0.5rem;
    width: fit-content;
  }
  .how-step h3 {
    color: var(--cpr-navy);
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }
  .how-step p {
    margin: 0;
    line-height: 1.5;
    color: #33433a;
  }

  /* FAQ */
  .faq {
    padding: 3.5rem 0;
    background: #fff;
  }
  .faq-list {
    max-width: 820px;
    margin: 0 auto;
  }
  .faq-item {
    border: 1px solid #e3e8e3;
    border-radius: 8px;
    padding: 0.5rem 1.25rem;
    margin-bottom: 0.75rem;
    background: #fbfdfb;
  }
  .faq-item summary {
    font-weight: 700;
    color: var(--cpr-navy);
    cursor: pointer;
    padding: 0.5rem 0;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item p {
    margin: 0 0 0.75rem;
    line-height: 1.6;
    color: #33433a;
  }

  /* Form */
  .form-section {
    padding: 3.5rem 0;
    background: #f3f6f3;
  }

  @media (max-width: 600px) {
    
    .cta-band-inner {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
  }
</style>
